diff --git a/common.cpp b/common.cpp
index e12cd7e..d5a0b79 100644
--- a/common.cpp
+++ b/common.cpp
@@ -124,21 +124,58 @@ EXPORT ICUException::ICUException(UErrorCode status, char *format, ...)
 
 EXPORT ICUException::ICUException(UParseError &pe, UErrorCode status)
 {
-    PyObject *messages = PyObject_GetAttrString(PyExc_ICUError, "messages");
     UnicodeString pre((const UChar *) pe.preContext, U_PARSE_CONTEXT_LEN);
     UnicodeString post((const UChar *) pe.postContext, U_PARSE_CONTEXT_LEN);
-    PyObject *tuple = PyTuple_New(5);
-
+    PyObject *messages = PyObject_GetAttrString(PyExc_ICUError, "messages");
     ICUException::code = PyInt_FromLong((long) status);
-
-    PyTuple_SET_ITEM(tuple, 0, PyObject_GetItem(messages, code));
-    PyTuple_SET_ITEM(tuple, 1, PyInt_FromLong(pe.line));
-    PyTuple_SET_ITEM(tuple, 2, PyInt_FromLong(pe.offset));
-    PyTuple_SET_ITEM(tuple, 3, PyUnicode_FromUnicodeString(&pre));
-    PyTuple_SET_ITEM(tuple, 4, PyUnicode_FromUnicodeString(&post));
-    ICUException::msg = tuple;
-
-    Py_DECREF(messages);
+    ICUException::msg = NULL;
+
+    if (!messages || !code)
+    {
+        Py_XDECREF(messages);
+        Py_CLEAR(ICUException::code);
+        return;
+    }
+
+    PyObject *message = PyObject_GetItem(messages, code);
+    if (!message)
+    {
+        // The table can lag new ICU error codes. Never put the resulting NULL
+        // into a tuple: Python 3.14's tuple formatter dereferences it.
+        if (!PyErr_ExceptionMatches(PyExc_KeyError))
+        {
+            Py_DECREF(messages);
+            Py_CLEAR(ICUException::code);
+            return;
+        }
+        PyErr_Clear();
+        message = PyString_FromString(u_errorName(status));
+    }
+    if (!message)
+    {
+        Py_DECREF(messages);
+        Py_CLEAR(ICUException::code);
+        return;
+    }
+
+    PyObject *line = PyInt_FromLong(pe.line);
+    PyObject *offset = PyInt_FromLong(pe.offset);
+    PyObject *preContext = PyUnicode_FromUnicodeString(&pre);
+    PyObject *postContext = PyUnicode_FromUnicodeString(&post);
+
+    if (message && line && offset && preContext && postContext)
+        ICUException::msg = PyTuple_Pack(5, message, line, offset,
+                                         preContext, postContext);
+
+    Py_XDECREF(messages);
+    Py_XDECREF(message);
+    Py_XDECREF(line);
+    Py_XDECREF(offset);
+    Py_XDECREF(preContext);
+    Py_XDECREF(postContext);
+
+    if (!ICUException::msg)
+        Py_CLEAR(ICUException::code);
 }
 
 EXPORT ICUException::~ICUException()
